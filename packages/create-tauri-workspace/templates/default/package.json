{
  "name": "__PROJECT_SLUG__",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "crates/app"
  ],
  "scripts": {
    "dev": "bun run --cwd crates/app tauri dev",
    "build": "bun run --cwd crates/app tauri build",
    "tauri": "bun run --cwd crates/app tauri",
    "frontend:dev": "bun run --cwd apps/desktop dev",
    "frontend:build": "bun run --cwd apps/desktop build",
    "frontend:check": "bun run --cwd apps/desktop check",
    "check": "cargo fmt --all --check && bun run frontend:check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "doctor": "node scripts/doctor.js",
    "release:check": "node scripts/release-check.js",
    "updater:init": "node scripts/updater-init.js",
    "updater:serve": "node scripts/updater-serve.js"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  }
}
