{
  "name": "create-tauri-workspace-repo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run test && node --check scripts/publish.js && bun run verify:package && bun run verify:site",
    "test": "node --test packages/create-tauri-workspace/test/*.test.js",
    "doctor": "node packages/create-tauri-workspace/bin/create-tauri-workspace.js doctor",
    "pack": "npm pack --workspace packages/create-tauri-workspace",
    "pack:dry": "npm pack --workspace packages/create-tauri-workspace --dry-run",
    "verify:package": "node scripts/verify-package.js",
    "verify:site": "node scripts/verify-site.js",
    "skill:install": "node packages/create-tauri-workspace/bin/create-tauri-workspace.js skill install",
    "publish": "node scripts/publish.js"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4"
  }
}
